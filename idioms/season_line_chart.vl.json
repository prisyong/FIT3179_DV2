{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Which season has the most sightings?",
    "subtitle": "Total sightings of all 8 species per season, 2025 (Summer = Dec\u2013Feb)"
  },
  "width": 330,
  "height": 280,
  "data": {
    "url": "data/season_line_chart_data.csv"
  },
  "encoding": {
    "x": {
      "field": "Season",
      "type": "ordinal",
      "sort": ["Summer", "Autumn", "Winter", "Spring"],
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12,
        "ticks": false
      }
    },
    "y": {
      "field": "Sightings",
      "type": "quantitative",
      "title": "Sightings",
      "scale": { "domain": [0, 300000], "nice": false },
      "axis": {
        "format": "~s",
        "values": [0, 100000, 200000, 300000]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "width": { "band": 0.6 }
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.Season == 'Spring'",
            "value": "#2171b5"
          },
          "value": "#b8c7d9"
        },
        "tooltip": [
          { "field": "Season" },
          { "field": "Sightings", "type": "quantitative", "format": "," },
          { "field": "Share_Pct", "title": "Share of year (%)" }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "baseline": "bottom",
        "dy": -6,
        "fontSize": 11,
        "color": "#444444"
      },
      "encoding": {
        "text": { "field": "Sightings", "type": "quantitative", "format": "," }
      }
    },
    {
      "transform": [
        {
          "joinaggregate": [
            { "op": "sum", "field": "Sightings", "as": "Total" }
          ]
        },
        { "calculate": "datum.Sightings / datum.Total", "as": "Share" }
      ],
      "mark": {
        "type": "text",
        "baseline": "top",
        "dy": 8,
        "fontSize": 13,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": { "field": "Share", "type": "quantitative", "format": ".0%" },
        "color": {
          "condition": {
            "test": "datum.Season == 'Spring'",
            "value": "#ffffff"
          },
          "value": "#3d4f66"
        }
      }
    },
    {
      "data": {
        "values": [{ "Season": "Summer", "Sightings": 292000 }]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": -24,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#2171b5",
        "lineHeight": 15
      },
      "encoding": {
        "text": {
          "value": [
            "Spring: about 64,000 more sightings",
            "than autumn, the quietest season"
          ]
        }
      }
    }
  ]
}
