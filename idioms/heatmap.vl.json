{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Which birds dominate each state?",
    "subtitle": "Share of each state's sightings made up by each species, 2025"
  },
  "width": {
    "step": 58
  },
  "height": {
    "step": 34
  },
  "data": {
    "url": "data/heatmap_data.csv"
  },
  "encoding": {
    "x": {
      "field": "State_Short",
      "type": "nominal",
      "sort": [
        "ACT",
        "NSW",
        "QLD",
        "SA",
        "TAS",
        "VIC",
        "WA",
        "NT"
      ],
      "title": null,
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "domain": false,
        "ticks": false
      }
    },
    "y": {
      "field": "Species",
      "type": "nominal",
      "sort": [
        "Australian Magpie",
        "Rainbow Lorikeet",
        "Superb Fairywren",
        "Sulphur-crested Cockatoo",
        "Laughing Kookaburra",
        "Wedge-tailed Eagle",
        "Tawny Frogmouth",
        "Emu"
      ],
      "title": null,
      "axis": {
        "domain": false,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#ffffff",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "Share_Pct",
          "type": "quantitative",
          "title": "Share (%)",
          "scale": {
            "scheme": "blues",
            "domain": [
              0,
              75
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 220
          }
        },
        "tooltip": [
          {
            "field": "State"
          },
          {
            "field": "Species"
          },
          {
            "field": "Share_Pct",
            "title": "Share (%)"
          },
          {
            "field": "Sightings",
            "type": "quantitative",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10
      },
      "encoding": {
        "text": {
          "field": "Share_Pct",
          "type": "quantitative",
          "format": ".0f"
        },
        "color": {
          "condition": {
            "test": "datum.Share_Pct > 40",
            "value": "#ffffff"
          },
          "value": "#333333"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "State_Short": "NT",
            "Species": "Sulphur-crested Cockatoo"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "fill": null,
        "stroke": "#222222",
        "strokeWidth": 2
      }
    },
    {
      "data": {
        "values": [
          {
            "State_Short": "NT",
            "Species": "Sulphur-crested Cockatoo"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#222222",
        "lineHeight": 15,
        "dx": 36
      },
      "encoding": {
        "text": {
          "value": [
            "\u2190 73% of NT sightings",
            "are cockatoos"
          ]
        }
      }
    }
  ]
}