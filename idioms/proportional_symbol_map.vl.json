{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where are the sighting hotspots?",
    "subtitle": [
      "50 busiest ~100 km areas for the chosen species, circle area = number of sightings, 2025",
      "Annotation shown for All species"
    ]
  },
  "width": 520,
  "height": 450,
  "projection": {
    "type": "albers",
    "parallels": [-18, -36],
    "rotate": [-132, 0],
    "center": [0, -27]
  },
  "view": {
    "fill": "#ebe8e1",
    "stroke": null
  },
  "params": [
    {
      "name": "pick",
      "value": "All species",
      "bind": {
        "input": "select",
        "name": "Species: ",
        "options": [
          "All species",
          "Australian Magpie",
          "Emu",
          "Laughing Kookaburra",
          "Rainbow Lorikeet",
          "Sulphur-crested Cockatoo",
          "Superb Fairywren",
          "Tawny Frogmouth",
          "Wedge-tailed Eagle"
        ]
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ffffff",
        "stroke": "#999999",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/proportional_symbol_map_data.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Latitude": "number",
            "Longitude": "number",
            "Sightings": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.Species == pick"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#2171b5",
        "opacity": 0.55,
        "stroke": "#ffffff",
        "strokeWidth": 0.6
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "Sightings",
          "type": "quantitative",
          "scale": {
            "range": [6, 900],
            "zero": false,
            "domainMin": 1
          },
          "legend": {
            "title": "Sightings",
            "tickCount": 3,
            "format": ",.0f",
            "symbolFillColor": "#2171b5",
            "symbolOpacity": 0.55,
            "symbolStrokeColor": "#ffffff",
            "formatType": "number",
            "labelLimit": 120
          }
        },
        "order": {
          "field": "Sightings",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "Species"
          },
          {
            "field": "Sightings",
            "type": "quantitative",
            "format": ","
          },
          {
            "field": "Latitude",
            "type": "quantitative",
            "format": ".2f"
          },
          {
            "field": "Longitude",
            "type": "quantitative",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [{}]
      },
      "transform": [
        {
          "filter": "pick == 'All species'"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#222222",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "datum": 142.2
        },
        "latitude": {
          "datum": -39.4
        },
        "longitude2": {
          "datum": 145.5
        },
        "latitude2": {
          "datum": -37.5
        }
      }
    },
    {
      "data": {
        "values": [{}]
      },
      "transform": [
        {
          "filter": "pick == 'All species'"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 30,
        "color": "#222222",
        "opacity": 1
      },
      "encoding": {
        "longitude": {
          "datum": 145.5
        },
        "latitude": {
          "datum": -37.5
        }
      }
    },
    {
      "data": {
        "values": [{}]
      },
      "transform": [
        {
          "filter": "pick == 'All species'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#222222",
        "lineHeight": 14,
        "dy": 4
      },
      "encoding": {
        "longitude": {
          "datum": 141.8
        },
        "latitude": {
          "datum": -39.4
        },
        "text": {
          "value": [
            "Greater Melbourne: 81,410 sightings",
            "the busiest area in Australia"
          ]
        }
      }
    }
  ]
}
