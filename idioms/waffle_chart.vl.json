{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Each species' share of all sightings",
    "subtitle": "Each square = 1% of the 867,022 sightings in 2025"
  },
  "width": 330,
  "height": 330,
  "layer": [
    {
      "data": {
        "url": "data/waffle_chart_data.csv",
        "format": {
          "type": "csv",
          "parse": { "Row": "number", "Col": "number" }
        }
      },
      "mark": {
        "type": "rect",
        "stroke": "#ffffff",
        "strokeWidth": 3,
        "cornerRadius": 3
      },
      "encoding": {
        "x": { "field": "Col", "type": "ordinal", "axis": null },
        "y": { "field": "Row", "type": "ordinal", "axis": null },
        "color": {
          "field": "Species",
          "type": "nominal",
          "scale": {
            "domain": [
              "Australian Magpie",
              "Rainbow Lorikeet",
              "Superb Fairywren",
              "Sulphur-crested Cockatoo",
              "Laughing Kookaburra",
              "Wedge-tailed Eagle",
              "Tawny Frogmouth",
              "Emu"
            ],
            "range": [
              "#4c78a8",
              "#f58518",
              "#54a24b",
              "#e45756",
              "#72b7b2",
              "#b279a2",
              "#9d755d",
              "#eeca3b"
            ]
          },
          "title": "Species",
          "legend": {
            "orient": "right",
            "direction": "vertical",
            "columns": 1,
            "offset": 16,
            "title": null,
            "labelFontSize": 11,
            "symbolSize": 90,
            "rowPadding": 8
          }
        },
        "tooltip": [
          { "field": "Species" },
          { "field": "Squares", "title": "Squares (%)" },
          { "field": "Share_Pct", "title": "Exact share (%)" }
        ]
      }
    },
    {
      "data": { "values": [{}] },
      "mark": {
        "type": "rect",
        "fill": "#333333",
        "fillOpacity": 0.55,
        "cornerRadius": 6
      },
      "encoding": {
        "x": { "value": 60 },
        "x2": { "value": 270 },
        "y": { "value": 37 },
        "y2": { "value": 63 }
      }
    },
    {
      "data": { "values": [{}] },
      "mark": {
        "type": "rect",
        "fill": "#333333",
        "fillOpacity": 0.55,
        "cornerRadius": 6
      },
      "encoding": {
        "x": { "value": 140 },
        "x2": { "value": 270 },
        "y": { "value": 269 },
        "y2": { "value": 291 }
      }
    },
    {
      "data": { "values": [{}] },
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#ffffff"
      },
      "encoding": {
        "x": { "value": 165 },
        "y": { "value": 50 },
        "text": { "value": "Australian Magpie: 29 squares" }
      }
    },
    {
      "data": { "values": [{}] },
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#ffffff"
      },
      "encoding": {
        "x": { "value": 205 },
        "y": { "value": 280 },
        "text": { "value": "Emu: just 1 square" }
      }
    },
    {
      "data": { "values": [{}] },
      "mark": { "type": "rule", "color": "#222222", "strokeWidth": 2 },
      "encoding": {
        "x": { "value": 273 },
        "y": { "value": 280 },
        "x2": { "value": 303 },
        "y2": { "value": 304 }
      }
    },
    {
      "data": { "values": [{}] },
      "mark": {
        "type": "point",
        "shape": "triangle",
        "angle": 129,
        "size": 50,
        "filled": true,
        "color": "#222222",
        "opacity": 1
      },
      "encoding": {
        "x": { "value": 303 },
        "y": { "value": 304 }
      }
    }
  ]
}
