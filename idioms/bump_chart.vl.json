{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Does the order of species change through the year?",
    "subtitle": "Each species' rank by sightings in each month of 2025 (1 = most reported)"
  },
  "width": 560,
  "height": 300,
  "data": {
    "url": "data/bump_chart_data.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Rank": "number"
      }
    }
  },
  "encoding": {
    "x": {
      "field": "Month",
      "type": "ordinal",
      "sort": [
        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun",
        "Jul",
        "Aug",
        "Sep",
        "Oct",
        "Nov",
        "Dec"
      ],
      "title": "Month (1 = January)",
      "axis": {
        "labelAngle": 0,
        "labelAlign": "center",
        "labelFontSize": 11,
        "labelExpr": "indexof([\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"], datum.value) + 1"
      }
    },
    "y": {
      "field": "Rank",
      "type": "ordinal",
      "title": "Rank",
      "scale": {
        "domain": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ]
      }
    },
    "color": {
      "field": "Species",
      "type": "nominal",
      "scale": {
        "domain": [
          "Australian Magpie",
          "Rainbow Lorikeet",
          "Superb Fairywren",
          "Sulphur-crested Cockatoo",
          "Laughing Kookaburra",
          "Wedge-tailed Eagle",
          "Tawny Frogmouth",
          "Emu"
        ],
        "range": [
          "#4c78a8",
          "#f58518",
          "#54a24b",
          "#e45756",
          "#72b7b2",
          "#b279a2",
          "#9d755d",
          "#eeca3b"
        ]
      },
      "legend": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "interpolate": "monotone"
      },
      "encoding": {
        "opacity": {
          "condition": {
            "test": "datum.Species == 'Superb Fairywren'",
            "value": 1
          },
          "value": 0.4
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.Species == 'Superb Fairywren'",
            "value": 5
          },
          "value": 3
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 80,
        "opacity": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "Species"
          },
          {
            "field": "Month"
          },
          {
            "field": "Rank"
          },
          {
            "field": "Sightings",
            "type": "quantitative",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Month == 'Dec'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 11
      },
      "encoding": {
        "text": {
          "field": "Species"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Month": "Aug",
            "Rank": 8
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#2e7d32",
        "lineHeight": 15,
        "dy": 70,
        "baseline": "top"
      },
      "encoding": {
        "color": {
          "value": "#2e7d32"
        },
        "text": {
          "value": "↑ Superb Fairywren drops from 3rd to 5th in late winter (month 8, August)"
        }
      }
    }
  ]
}