{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How did sightings change through 2025?",
    "subtitle": "Total sightings of all 8 species per month"
  },
  "width": 330,
  "height": 300,
  "data": { "url": "data/line_chart_data.csv" },
  "encoding": {
    "x": {
      "field": "Month",
      "type": "ordinal",
      "sort": [
        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun",
        "Jul",
        "Aug",
        "Sep",
        "Oct",
        "Nov",
        "Dec"
      ],
      "title": null,
      "axis": { "labelAngle": 0 }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "color": "#2171b5",
        "point": { "filled": true, "size": 60, "color": "#2171b5" }
      },
      "encoding": {
        "y": {
          "field": "Sightings",
          "type": "quantitative",
          "title": "Sightings",
          "scale": { "zero": true },
          "axis": { "format": "~s" }
        },
        "tooltip": [
          { "field": "Month" },
          { "field": "Sightings", "type": "quantitative", "format": "," },
          { "field": "Observers", "type": "quantitative", "format": "," }
        ]
      }
    },
    {
      "data": { "values": [{ "Month": "May", "Sightings": 90000 }] },
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#222222",
        "lineHeight": 14
      },
      "encoding": {
        "y": { "field": "Sightings", "type": "quantitative" },
        "text": {
          "value": ["Peak: 93,308 in October –", "54% above February's low"]
        }
      }
    }
  ]
}
